# Packaging for Roni's ItemPedia (BigWigsMods/packager).
#
# The repository root is the whole AddOns folder and this addon lives in a
# subfolder, so the packager copies the repo into .release/RonisItemPedia/ and
# move-folders lifts the addon folder up one level. The release workflow runs
# the packager with `-m RonisItemPedia/.pkgmeta`; all paths here are relative
# to the repository root.

package-as: RonisItemPedia

enable-nolib-creation: no

move-folders:
  RonisItemPedia/RonisItemPedia: RonisItemPedia

# Release notes shown on CurseForge / Wago (written by hand before tagging).
manual-changelog:
  filename: RonisItemPedia/CHANGELOG.md
  markup-type: markdown

# Repo files, developer tools and the other addons in this repository
# (each has its own release)
ignore:
  - README.md
  - LICENSE
  - RonisItemPedia/tools
  - RonisMailMats
