# Packaging for Roni's MailMats (BigWigsMods/packager).
#
# The repository root is the whole AddOns folder, so the packager copies the
# repo into .release/RonisMailMats/. move-folders lifts the addon's own files
# to the top of that folder and `ignore` drops everything else. The release
# workflow runs the packager with `-m RonisMailMats/.pkgmeta`; all paths here
# are relative to the repository root. CurseForge and Wago project IDs come
# from RonisMailMats.toc.

package-as: RonisMailMats

enable-nolib-creation: no

move-folders:
  RonisMailMats/RonisMailMats: RonisMailMats

# Release notes shown on CurseForge / Wago (written by hand before tagging).
manual-changelog:
  filename: RonisMailMats/CHANGELOG.md
  markup-type: markdown

# Everything that is not this addon, and developer tools players do not need
ignore:
  - README.md
  - LICENSE
  - site
  - RonisItemPedia
  - RonisMailMats/tools
  - RonisMailMats/tests
  - RonisMailMats/docs
